{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User preferences and basic info",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "defaultFormat": { "type": "string" },
        "defaultQuality": { "type": "string" },
        "defaultStyle": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "ImageResult": {
      "title": "Generated Image",
      "description": "Information about an image generated by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "prompt": { "type": "string" },
        "settings": {
          "type": "object",
          "properties": {
            "format": { "type": "string" },
            "quality": { "type": "string" },
            "style": { "type": "string" },
            "count": { "type": "number" }
          }
        },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "url", "prompt", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and settings"
    },
    "/users/{userId}/history/{imageId}": {
      "schema": "ImageResult",
      "description": "User's image generation history"
    }
  }
}
